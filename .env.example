# ==========================================
# RAG Studio Environment Configuration
# ==========================================

# Public Hosted Demo Mode Settings
# Set DEMO_MODE=true when deploying live for public visitors/recruiters.
# In Demo Mode:
#   1. Viewers do NOT need to paste an API key; the server's hosted key is used automatically.
#   2. Modification/clearing of server API keys in Settings is locked to protect your credentials.
#   3. Baseline sample pipeline and handbook are protected from deletion.
#   4. Sliding-window rate limiting is enforced per client IP.
DEMO_MODE=false
RATE_LIMIT_PER_MINUTE=15

# Model Provider API Keys (Server-Side)
# Recommended for free live hosting: Groq Cloud (Free Tier, 300+ tok/s)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=

# Local / Self-Hosted Models
OLLAMA_BASE_URL=http://localhost:11434

# Vector Store Storage Paths
DEFAULT_VECTOR_STORE=chroma
CHROMA_PERSIST_DIRECTORY=./storage/chromadb
